[Unit]
Description=AzerothCore Database and Config Backup Service
Documentation=https://www.azerothcore.org/
After=azerothcore.service

[Service]
Type=oneshot
WorkingDirectory=/root/azerothcore-wotlk

# Run backup scripts
ExecStart=/root/azerothcore-wotlk/scripts/backup-databases.sh
ExecStart=/root/azerothcore-wotlk/scripts/backup-configs.sh

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=azerothcore-backup
