{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["git-submodules"],
  "git-submodules": {
    "enabled": true
  },
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "matchManagers": ["git-submodules"],
      "groupName": "module submodules",
      "automerge": false
    }
  ]
}
